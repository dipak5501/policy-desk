# Solana RPC — prefer a private Devnet endpoint (QuickNode) for demos.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com

# Network: hackathon demo = Devnet only
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Circle USDC on Solana Devnet
# https://developers.circle.com/stablecoins/usdc-contract-addresses
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Trusted origin for local merchant path resources (not from request Host)
TRUSTED_MERCHANT_ORIGIN=http://127.0.0.1:3000
# NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000

# x402 V2 CAIP-2 network id (Devnet) — local demo paywall; not a hosted facilitator claim
# https://solana.com/docs/payments/agentic-payments/x402
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# X402_PAY_TO=

# Policy defaults (USDC base units: 6 decimals → 1_000_000 = $1)
POLICY_DAILY_CAP_BASE_UNITS=5000000
POLICY_PER_TX_CAP_BASE_UNITS=1000000
POLICY_APPROVAL_THRESHOLD_BASE_UNITS=500000

# Operator password — SERVER ONLY (never NEXT_PUBLIC_*)
# Used by /api/operator/login → HttpOnly session cookie + CSRF in JSON
OPERATOR_TOKEN=replace-with-strong-operator-password

# Session HMAC secret (required in public demos; falls back to OPERATOR_TOKEN if unset)
SESSION_SECRET=replace-with-long-random-secret

# Optional SQLite path (default: .data/ledger.sqlite)
# LEDGER_DB_PATH=.data/ledger.sqlite

# Optional live model adapter (fixture mode works without this)
# Without OPENAI_API_KEY, live mode reports LIVE UNVERIFIED — do not invent keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: QuickNode Streams ticker — not payment reconcile / bounty-ready
# QUICKNODE_STREAM_WEBHOOK_SECRET=replace-me
